#: mate-submodules/libegg/eggdesktopfile.c:169
msgid "File is not a valid .desktop file"
msgstr "ໄຟລ໌ນີ້ບໍ່ແມ່ນໄຟລ໌ .desktop ທີ່ຖືກຕ້ອງ"

#: mate-submodules/libegg/eggdesktopfile.c:194
#, c-format
msgid "Unrecognized desktop file Version '%s'"
msgstr "ບໍ່ຮູ້ຈັກເວີຊັນຂອງໄຟລ໌ເດດທັອບ '%s'"

#: mate-submodules/libegg/eggdesktopfile.c:984
#, c-format
msgid "Starting %s"
msgstr "ກຳລັງເລີ່ມ %s"

#: mate-submodules/libegg/eggdesktopfile.c:1126
msgid "Application does not accept documents on command line"
msgstr "ແອັບພລິເຄຊັນບໍ່ຮອງຮັບການເປີດເອກະສານຜ່ານຄຳສັ່ງ (command line)"

#: mate-submodules/libegg/eggdesktopfile.c:1194
#, c-format
msgid "Unrecognized launch option: %d"
msgstr "ບໍ່ຮູ້ຈັກຕົວເລືອກການເປີດ: %d"

#: mate-submodules/libegg/eggdesktopfile.c:1410
msgid "Can't pass document URIs to a 'Type=Link' desktop entry"
msgstr "ບໍ່ສາມາດສົ່ງ URI ຂອງເອກະສານໄປຫາໄຟລ໌ເດດທັອບທີ່ມີ 'Type=Link'"

#: mate-submodules/libegg/eggdesktopfile.c:1431
msgid "Not a launchable item"
msgstr "ບໍ່ແມ່ນລາຍການທີ່ສາມາດເປີດໃຊ້ງານໄດ້"

#: mate-submodules/libegg/eggsmclient.c:234
msgid "Disable connection to session manager"
msgstr "ປິດການເຊື່ອມຕໍ່ກັບຕົວຈັດການເຊດຊັນ (session manager)"

#: mate-submodules/libegg/eggsmclient.c:239
msgid "Specify file containing saved configuration"
msgstr "ລະບຸໄຟລ໌ທີ່ບັນຈຸການຕັ້ງຄ່າທີ່ບັນທຶກໄວ້"

#: mate-submodules/libegg/eggsmclient.c:239
msgid "FILE"
msgstr "ໄຟລ໌"

#: mate-submodules/libegg/eggsmclient.c:244
msgid "Specify session management ID"
msgstr "ລະບຸ ID ຂອງການຈັດການເຊດຊັນ"

#: mate-submodules/libegg/eggsmclient.c:244
msgid "ID"
msgstr "ID"

#: mate-submodules/libegg/eggsmclient.c:270
msgid "Session management options:"
msgstr "ຕົວເລືອກການຈັດການເຊດຊັນ:"

#: mate-submodules/libegg/eggsmclient.c:271
msgid "Show session management options"
msgstr "ສະແດງຕົວເລືອກການຈັດການເຊດຊັນ"

#: data/engrampa.appdata.xml.in.in:7 data/engrampa.desktop.in.in:3
#: src/main.c:47
msgid "Engrampa Archive Manager"
msgstr "Engrampa ຕົວຈັດການໄຟລ໌ຈັດເກັບ"

#: data/engrampa.appdata.xml.in.in:8
msgid "An Archive Manager for the MATE desktop environment"
msgstr "ຕົວຈັດການໄຟລ໌ຈັດເກັບສຳລັບສະພາບແວດລ້ອມເດັສທັອບ MATE"

#: data/engrampa.appdata.xml.in.in:10
msgid ""
"Engrampa is an archive manager for the MATE environment. It allows you to "
"create and modify archives, view the contents of an archive, view a file "
"contained in an archive, and extract files from archive."
msgstr ""
"Engrampa ແມ່ນຕົວຈັດການໄຟລ໌ຈັດເກັບສຳລັບສະພາບແວດລ້ອມ MATE. ມັນຊ່ວຍໃຫ້ທ່ານສາມາດສ້າງ ແລະ ແກ້ໄຂໄ"
"ຟລ໌ຈັດເກັບ, ເບິ່ງເນື້ອໃນຂອງໄຟລ໌ຈັດເກັບ, ເບິ່ງໄຟລ໌ທີ່ຢູ່ໃນໄຟລ໌ຈັດເກັບ ແລະ ແຍກໄຟລ໌ອອກຈາກໄຟລ໌ຈັດເກັບ."

#: data/engrampa.appdata.xml.in.in:15
msgid ""
"Engrampa is only a front-end (a graphical interface) to archiving programs "
"like tar and zip. The supported file types are:"
msgstr ""
"Engrampa ເປັນພຽງສ່ວນຕິດຕໍ່ຜູ້ໃຊ້ (ສ່ວນຕິດຕໍ່ແບບກຣາຟິກ) ໃຫ້ກັບໂປຣແກຣມຈັດເກັບໄຟລ໌ ເຊັ່ນ tar ແລະ "
"zip. ປະເພດໄຟລ໌ທີ່ຮອງຮັບຄື:"

#: data/engrampa.appdata.xml.in.in:20
msgid "7-Zip Compressed File (.7z)"
msgstr "ໄຟລ໌ບີບອັດ 7-Zip (.7z)"

#: data/engrampa.appdata.xml.in.in:21
msgid "WinAce Compressed File (.ace)"
msgstr "ໄຟລ໌ບີບອັດ WinAce (.ace)"

#: data/engrampa.appdata.xml.in.in:22
msgid "ALZip Compressed File (.alz)"
msgstr "ໄຟລ໌ບີບອັດ ALZip (.alz)"

#: data/engrampa.appdata.xml.in.in:23
msgid "AIX Small Indexed Archive (.ar)"
msgstr "ໄຟລ໌ຈັດເກັບ AIX Small Indexed (.ar)"

#: data/engrampa.appdata.xml.in.in:24
msgid "ARJ Compressed Archive (.arj)"
msgstr "ໄຟລ໌ຈັດເກັບບີບອັດ ARJ (.arj)"

#: data/engrampa.appdata.xml.in.in:25
msgid "Cabinet File (.cab)"
msgstr "ໄຟລ໌ Cabinet (.cab)"

#: data/engrampa.appdata.xml.in.in:26
msgid "UNIX CPIO Archive (.cpio)"
msgstr "ໄຟລ໌ຈັດເກັບ UNIX CPIO (.cpio)"

#: data/engrampa.appdata.xml.in.in:27
msgid "Debian Package (.deb, .udeb) [Read-only mode]"
msgstr "ແພັກເກດ Debian (.deb, .udeb) [ໂໝດອ່ານຢ່າງດຽວ]"

#: data/engrampa.appdata.xml.in.in:28
msgid "ISO-9660 Disk Image (.iso) [Read-only mode]"
msgstr "ອິເມຈດິສ ISO-9660 (.iso) [ໂໝດອ່ານຢ່າງດຽວ]"

#: data/engrampa.appdata.xml.in.in:29
msgid "Java Archive (.jar)"
msgstr "ໄຟລ໌ຈັດເກັບ Java (.jar)"

#: data/engrampa.appdata.xml.in.in:30
msgid "Java Enterprise archive (.ear)"
msgstr "ໄຟລ໌ຈັດເກັບ Java Enterprise (.ear)"

#: data/engrampa.appdata.xml.in.in:31
msgid "Java Web Archive (.war)"
msgstr "ໄຟລ໌ຈັດເກັບ Java Web (.war)"

#: data/engrampa.appdata.xml.in.in:32
msgid "LHA Archive (.lzh, .lha)"
msgstr "ໄຟລ໌ຈັດເກັບ LHA (.lzh, .lha)"

#: data/engrampa.appdata.xml.in.in:33
msgid "WinRAR Compressed Archive (.rar)"
msgstr "ໄຟລ໌ຈັດເກັບບີບອັດ WinRAR (.rar)"

#: data/engrampa.appdata.xml.in.in:34
msgid "RAR Archived Comic Book (.cbr)"
msgstr "ປຶ້ມກາຕູນຈັດເກັບແບບ RAR (.cbr)"

#: data/engrampa.appdata.xml.in.in:35
msgid "RPM Package Manager (.rpm) [Read-only mode]"
msgstr "ແພັກເກດ RPM (.rpm) [ໂໝດອ່ານຢ່າງດຽວ]"

#: data/engrampa.appdata.xml.in.in:36
msgid ""
"Tape Archive File uncompressed (.tar) or compressed with: gzip (.tar.gz, "
".tgz), brotli (.tar.br), bzip (.tar.bz, .tbz), bzip2 (.tar.bz2, .tbz2), "
"compress (.tar.Z, .taz), lrzip (.tar.lrz, .tlrz), lzip (.tar.lz, .tlz), lzop"
" (.tar.lzo, .tzo), 7zip (.tar.7z), xz (.tar.xz), Zstandard (.zst)"
msgstr ""
"ໄຟລ໌ຈັດເກັບ Tape ແບບບໍ່ບີບອັດ (.tar) ຫຼື ບີບອັດດ້ວຍ: gzip (.tar.gz, .tgz), brotli "
"(.tar.br), bzip (.tar.bz, .tbz), bzip2 (.tar.bz2, .tbz2), compress (.tar.Z, "
".taz), lrzip (.tar.lrz, .tlrz), lzip (.tar.lz, .tlz), lzop (.tar.lzo, .tzo), "
"7zip (.tar.7z), xz (.tar.xz), Zstandard (.zst)"

#: data/engrampa.appdata.xml.in.in:39
msgid "Stuffit Archives (.bin, .sit)"
msgstr "ໄຟລ໌ຈັດເກັບ Stuffit (.bin, .sit)"

#: data/engrampa.appdata.xml.in.in:40
msgid "ZIP Archive (.zip)"
msgstr "ໄຟລ໌ຈັດເກັບ ZIP (.zip)"

#: data/engrampa.appdata.xml.in.in:41
msgid "ZIP Archived Comic Book (.cbz)"
msgstr "ປຶ້ມກາຕູນຈັດເກັບແບບ ZIP (.cbz)"

#: data/engrampa.appdata.xml.in.in:42
msgid "ZOO Compressed Archive File (.zoo)"
msgstr "ໄຟລ໌ຈັດເກັບບີບອັດ ZOO (.zoo)"

#: data/engrampa.appdata.xml.in.in:43
msgid ""
"Single files compressed with gzip (.gz), brotli (.br), bzip (.bz), bzip2 "
"(.bz2), compress (.Z), lrzip (.lrz), lzip (.lz), lzop (.lzo), rzip(.rz), xz "
"(.xz)."
msgstr ""
"ໄຟລ໌ດ່ຽວທີ່ບີບອັດດ້ວຍ gzip (.gz), brotli (.br), bzip (.bz), bzip2 (.bz2), compress "
"(.Z), lrzip (.lrz), lzip (.lz), lzop (.lzo), rzip(.rz), xz (.xz)."

#: data/engrampa.appdata.xml.in.in:46
msgid ""
"Engrampa is a fork of File Roller and part of the MATE Desktop Environment. "
"If you would like to know more about MATE and Engrampa, please visit the "
"project's home page."
msgstr ""
"Engrampa ແມ່ນຊອບແວທີ່ແຍກຕົວອອກມາຈາກ File Roller ແລະ ເປັນສ່ວນໜຶ່ງຂອງສະພາບແວດລ້ອມເດັສທັອບ "
"MATE. ຫາກທ່ານຕ້ອງການຮູ້ຂໍ້ມູນເພີ່ມເຕີມກ່ຽວກັບ MATE ແລະ Engrampa, ກະລຸນາເຂົ້າເບິ່ງໜ້າຫຼັກຂອງໂຄງກາ"
"ນ."

#: data/engrampa.desktop.in.in:4 src/fr-window.c:1889 src/fr-window.c:5293
msgid "Archive Manager"
msgstr "ຕົວຈັດການໄຟລ໌ຈັດເກັບ"

#: data/engrampa.desktop.in.in:5
msgid "Create and modify an archive"
msgstr "ສ້າງ ແລະ ແກ້ໄຂໄຟລ໌ຈັດເກັບ"

#. Translators: Search terms to find this application. Do NOT translate or
#. localize the semicolons! The list MUST also end with a semicolon!
#: data/engrampa.desktop.in.in:17
msgid "MATE;archive;manager;compression;"
msgstr "MATE;ໄຟລ໌ຈັດເກັບ;ຕົວຈັດການ;ການບີບອັດ;"

#: data/org.mate.engrampa.gschema.xml.in:38
msgid "How to sort files"
msgstr "ວິທີຈັດລຽງໄຟລ໌"

#: data/org.mate.engrampa.gschema.xml.in:39
msgid ""
"What criteria must be used to arrange files. Possible values: name, size, "
"type, time, path."
msgstr ""
"ເກນທີ່ໃຊ້ໃນການຈັດລຽງໄຟລ໌. ຄ່າທີ່ເປັນໄປໄດ້: name (ຊື່), size (ຂະໜາດ), type (ປະເພດ), time "
"(ເວລາ), path (ເສັ້ນທາງ)."

#: data/org.mate.engrampa.gschema.xml.in:43
msgid "Sort type"
msgstr "ປະເພດການຈັດລຽງ"

#: data/org.mate.engrampa.gschema.xml.in:44
msgid ""
"Whether to sort in ascending or descending direction. Possible values: "
"ascending, descending."
msgstr ""
"ຈະຈັດລຽງໃນທິດທາງເພີ່ມຂຶ້ນ ຫຼື ຫຼຸດລົງ. ຄ່າທີ່ເປັນໄປໄດ້: ascending (ເພີ່ມຂຶ້ນ), descending (ຫຼຸດລົງ)."

#: data/org.mate.engrampa.gschema.xml.in:48
msgid "List Mode"
msgstr "ໂໝດລາຍການ"

#: data/org.mate.engrampa.gschema.xml.in:49
msgid ""
"Whether to view all files in the archive (all_files), or view the archive as"
" a folder (as_folder)."
msgstr ""
"ຈະໃຫ້ເບິ່ງໄຟລ໌ທັງໝົດໃນໄຟລ໌ຈັດເກັບ (all_files) ຫຼື ເບິ່ງໄຟລ໌ຈັດເກັບໃນຮູບແບບໂຟນເດີ (as_folder)."

#: data/org.mate.engrampa.gschema.xml.in:53
msgid "Display type"
msgstr "ສະແດງປະເພດ"

#: data/org.mate.engrampa.gschema.xml.in:54
msgid "Display the Type column in the main window."
msgstr "ສະແດງຖັນ 'ປະເພດ' ໃນໜ້າຕ່າງຫຼັກ."

#: data/org.mate.engrampa.gschema.xml.in:58
msgid "Display size"
msgstr "ສະແດງຂະໜາດ"

#: data/org.mate.engrampa.gschema.xml.in:59
msgid "Display the Size column in the main window."
msgstr "ສະແດງຖັນ 'ຂະໜາດ' ໃນໜ້າຕ່າງຫຼັກ."

#: data/org.mate.engrampa.gschema.xml.in:63
msgid "Display time"
msgstr "ສະແດງເວລາ"

#: data/org.mate.engrampa.gschema.xml.in:64
msgid "Display the Time column in the main window."
msgstr "ສະແດງຖັນ 'ເວລາ' ໃນໜ້າຕ່າງຫຼັກ."

#: data/org.mate.engrampa.gschema.xml.in:68
msgid "Display path"
msgstr "ສະແດງເສັ້ນທາງ"

#: data/org.mate.engrampa.gschema.xml.in:69
msgid "Display the Path column in the main window."
msgstr "ສະແດງຖັນ 'ເສັ້ນທາງ' ໃນໜ້າຕ່າງຫຼັກ."

#: data/org.mate.engrampa.gschema.xml.in:73
msgid "Use MIME icons"
msgstr "ໃຊ້ໄອຄອນ MIME"

#: data/org.mate.engrampa.gschema.xml.in:74
msgid ""
"if TRUE will display icons depending on the file type (slower), otherwise "
"will use always the same icon for all files (faster)."
msgstr ""
"ຫາກເປັນ TRUE ຈະສະແດງໄອຄອນຕາມປະເພດໄຟລ໌ (ຊ້າກວ່າ), ຖ້າບໍ່ດັ່ງນັ້ນຈະໃຊ້ໄອຄອນດຽວກັນສຳລັບທຸກໄຟລ໌ "
"(ໄວກວ່າ)."

#: data/org.mate.engrampa.gschema.xml.in:78
msgid "Name column width"
msgstr "ຄວາມກວ້າງຂອງຖັນຊື່"

#: data/org.mate.engrampa.gschema.xml.in:79
msgid "The default width of the name column in the file list."
msgstr "ຄວາມກວ້າງມາດຕະຖານຂອງຖັນຊື່ໃນລາຍການໄຟລ໌."

#: data/org.mate.engrampa.gschema.xml.in:85
msgid "Max history length"
msgstr "ຄວາມຍາວປະຫວັດສູງສຸດ"

#: data/org.mate.engrampa.gschema.xml.in:86
msgid "Max number of items in the Open Recents menu."
msgstr "ຈຳນວນລາຍການສູງສຸດໃນເມນູ 'ເປີດໄຟລ໌ຫຼ້າສຸດ'."

#: data/org.mate.engrampa.gschema.xml.in:99
msgid "View toolbar"
msgstr "ສະແດງແຖບເຄື່ອງມື"

#: data/org.mate.engrampa.gschema.xml.in:100
msgid "Whether to display the toolbar."
msgstr "ກຳນົດວ່າຈະສະແດງແຖບເຄື່ອງມືຫຼືບໍ່."

#: data/org.mate.engrampa.gschema.xml.in:104
msgid "View statusbar"
msgstr "ສະແດງແຖບສະຖານະ"

#: data/org.mate.engrampa.gschema.xml.in:105
msgid "Whether to display the statusbar."
msgstr "ກຳນົດວ່າຈະສະແດງແຖບສະຖານະຫຼືບໍ່."

#: data/org.mate.engrampa.gschema.xml.in:109 src/ui/menus-toolbars.ui:505
msgid "View the folders pane"
msgstr "ສະແດງຊ່ອງໂຟນເດີ"

#: data/org.mate.engrampa.gschema.xml.in:110
msgid "Whether to display the folders pane."
